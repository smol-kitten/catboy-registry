{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "catboy-registry",
  "type": "object",
  "required": [
    "pen",
    "assignee",
    "arcs"
  ],
  "properties": {
    "pen": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "assignee": {
      "type": "string"
    },
    "arcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "oid",
          "name",
          "status",
          "owner",
          "since",
          "purpose"
        ],
        "properties": {
          "oid": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "status": {
            "enum": [
              "reserved",
              "active",
              "deprecated"
            ]
          },
          "owner": {
            "type": "string"
          },
          "since": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "purpose": {
            "type": "string",
            "minLength": 8
          },
          "spec": {
            "type": "string"
          },
          "purl": {
            "type": "string",
            "pattern": "^pkg:[a-z][a-z0-9.+-]*/[^@?#\\s]+$",
            "description": "package URL of a software product (.1.11.<n>), without version"
          },
          "repo": {
            "type": "string",
            "pattern": "^https://[^\\s]+$",
            "description": "source repository URL of a software product"
          },
          "sysobjectid": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)*$",
            "description": "relative OID of the SNMP sysObjectID arc that this product reports"
          },
          "superseded_by": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)*$",
            "description": "relative OID of the arc that replaces this deprecated arc (docs/arcs.md, correction procedure)"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "oid": {
                  "pattern": "^1\\.11\\.[0-9]+$"
                }
              }
            },
            "then": {
              "required": [
                "purl",
                "repo"
              ]
            }
          },
          {
            "if": {
              "required": [
                "superseded_by"
              ]
            },
            "then": {
              "properties": {
                "status": {
                  "const": "deprecated"
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
