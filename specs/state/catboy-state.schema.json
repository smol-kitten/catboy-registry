{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smol-kitten/catboy-registry/blob/main/specs/state/catboy-state.schema.json",
  "title": "catboy-state: the /.well-known/catboy-state document (arc .1.13)",
  "type": "object",
  "required": ["version", "system", "epoch", "parent_epoch", "fork_seq", "seq", "root", "hlc"],
  "properties": {
    "version": {"const": 1, "description": "document format version"},
    "system": {"$ref": "#/$defs/uuid", "description": "uuid5(CATBOY_NAMESPACE, \"state-system:<software>/<instance>/<store>\"); never changes"},
    "epoch": {"$ref": "#/$defs/uuid", "description": "UUIDv7, minted at init and at every restore"},
    "parent_epoch": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}], "description": "the epoch this epoch was forked from; null for the first epoch"},
    "fork_seq": {"oneOf": [{"$ref": "#/$defs/seq"}, {"type": "null"}], "description": "the seq of parent_epoch at the restore point; null for the first epoch"},
    "seq": {"$ref": "#/$defs/seq", "description": "increases by 1 with every committed change in this epoch"},
    "root": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 over the sorted id:rev:content_hash lines"},
    "hlc": {"$ref": "#/$defs/u64", "description": "HLC of the last committed change: unix ms << 16 | logical, as a decimal string"},
    "instance": {"type": "integer", "minimum": 1, "description": "the registered instance number (.1.12.<n>)"},
    "software": {"type": "string", "pattern": "^1\\.3\\.6\\.1\\.4\\.1\\.66963\\.1\\.11\\.[0-9]+(\\.[0-9]+)*$", "description": "software or release OID of the product that serves the document"}
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "seq": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "u64": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"}
  }
}
